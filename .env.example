# ── Required for full RAG generation (not needed when demo_mode=true) ──
OPENAI_API_KEY=your_openai_api_key

# ── API server ─────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://localhost:8501

# ── RAG defaults ───────────────────────────────────────────────────────
DEFAULT_FILING_ID=apple_2025
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_TOP_K=5
GENERATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Cost estimation (USD per 1M tokens — adjust if pricing changes) ────
EMBED_PRICE_PER_1M=0.02
GPT_INPUT_PRICE_PER_1M=0.15
GPT_OUTPUT_PRICE_PER_1M=0.60

# ── Query cache ────────────────────────────────────────────────────────
QUERY_CACHE_MAX_ENTRIES=128

# ── Access policy (production defaults) ────────────────────────────────
ENFORCE_ACCESS_POLICY=true
ANONYMOUS_DEMO_ONLY=true
FREE_TIER_LLM_CALLS=1
PRO_TIER_LLM_CALLS_PER_DAY=100
PRO_TIER_DAILY_TOKEN_BUDGET=500000

# ── Rate limiting ──────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS_PER_HOUR=30/hour
RATE_LIMIT_AUTHENTICATED_PER_HOUR=120/hour
RATE_LIMIT_PRO_PER_HOUR=300/hour

# ── Supabase (backend JWT verification + quota store) ────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your_jwt_secret
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Docker (docker-compose.yml) ────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=3000
