# ── Required for full RAG generation (not needed when demo_mode=true) ──
OPENAI_API_KEY=your_openai_api_key

# ── API server ─────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://localhost:8501

# ── RAG defaults ───────────────────────────────────────────────────────
DEFAULT_FILING_ID=apple_2025
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_TOP_K=5
GENERATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Cost estimation (USD per 1M tokens — adjust if pricing changes) ────
EMBED_PRICE_PER_1M=0.02
GPT_INPUT_PRICE_PER_1M=0.15
GPT_OUTPUT_PRICE_PER_1M=0.60

# ── Query cache ────────────────────────────────────────────────────────
QUERY_CACHE_MAX_ENTRIES=128
