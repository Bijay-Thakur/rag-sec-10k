# Frontend environment variables — copy to frontend/.env.local for local dev.
# Never commit frontend/.env.local to git.

# ── Required (local + Vercel) ───────────────────────────────────────────────
# Public URL of the FastAPI backend (no trailing slash).
# Local: http://127.0.0.1:8770
# Vercel: https://your-api.example.com
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8770

# Site URL for auth redirects (local or production domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API (anon key is safe for the browser).
# Add redirect URLs in Supabase Auth → URL Configuration:
#   http://localhost:3000/api/auth/confirm
#   https://your-vercel-domain.vercel.app/api/auth/confirm
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# ── Server-only (Next.js API routes on Vercel / local) ───────────────────────
# Do NOT prefix with NEXT_PUBLIC_. Never expose these to the browser bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (optional — leave blank until subscriptions are enabled)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Vercel deployment notes ───────────────────────────────────────────────────
# Set these in Vercel → Project Settings → Environment Variables:
#   NEXT_PUBLIC_API_BASE_URL   (required — your public FastAPI URL)
#   NEXT_PUBLIC_SITE_URL       (your Vercel domain)
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY  (server-only; used by /api/auth/signup)
#
# Do NOT add to Vercel (backend container / Fly.io / Railway secrets only):
#   OPENAI_API_KEY
#   SUPABASE_JWT_SECRET
#   Any LLM or backend-only API keys
