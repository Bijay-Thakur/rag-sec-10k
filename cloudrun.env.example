# Google Cloud Run — backend environment template (no secrets committed).
#
# Usage:
#   cp cloudrun.env.example cloudrun.env
#   # Edit cloudrun.env with real values (never commit cloudrun.env)
#   gcloud run deploy sec-insight-api --env-vars-file cloudrun.env ...
#
# Prefer Secret Manager for OPENAI_API_KEY and Supabase keys in production:
#   gcloud run deploy ... --set-secrets OPENAI_API_KEY=openai-api-key:latest

# Do NOT set PORT here — Cloud Run injects it automatically (deploy fails if set).

OPENAI_API_KEY=LLM_MODEL=gpt-4o-mini
FRONTEND_ORIGIN=https://rag-sec-10k-alpha.vercel.app

ENABLE_LIVE_LLM_CALLS=false
DEMO_MODE_ONLY=true
MAX_DAILY_LLM_CALLS=25
MAX_DAILY_ESTIMATED_COST_USD=1.00
MAX_INPUT_TOKENS=4000
MAX_OUTPUT_TOKENS=500

# Required for authenticated live LLM + per-user quotas (use Secret Manager in prod)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Access policy (production defaults)
ENFORCE_ACCESS_POLICY=true
